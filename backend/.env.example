NFC_SERIAL_PORT=COM16
NFC_BAUD_RATE=115200
# Optional: use this when auto-detection selects the wrong network interface.
# PUBLIC_BASE_URL=http://10.22.4.155:5000

# Copy this file to .env; start.ps1 loads .env automatically.
# Relative credential paths resolve from the backend folder.
CHECKOUT_FIRESTORE_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Source schema is fixed: ticket_no, status=ready_for_checkout,
# items, totalCentavos. Payments use the session document ID.
